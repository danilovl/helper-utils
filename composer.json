{
    "name": "danilovl/helper-utils",
    "description": "Universal collection of helper utilities: dates, strings, arrays, files, network, reflection, hashing, colors and more.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "helper",
        "utils",
        "utilities",
        "date",
        "string",
        "array",
        "ip",
        "reflection"
    ],
    "authors": [
        {
            "name": "Vladimir Danilov"
        }
    ],
    "autoload": {
        "psr-4": {
            "Danilovl\\HelperUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danilovl\\HelperUtils\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5.0",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.5",
        "symfony/form": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/html-sanitizer": "^8.0",
        "doctrine/orm": "^3.0.0",
        "doctrine/persistence": "^4.0.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-symfony": "^2.0.9",
        "friendsofphp/php-cs-fixer": "^3.92.5",
        "symfony/intl": "^8.0",
        "symfony/string": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/clock": "^8.0",
        "symfony/property-access": "^8.0"
    },
    "scripts": {
        "tests": "vendor/bin/phpunit tests",
        "phpstan": "phpstan analyse -c phpstan.neon src tests --no-progress",
        "phpstan-generate-baseline": "@php vendor/bin/phpstan analyse --level 9  --configuration phpstan.neon  src/ tests/ --generate-baseline",
        "cs-fixer": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "cs-fixer-check": "vendor/bin/php-cs-fixer fix --dry-run --allow-risky=yes"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
